{
  "name": "openweatherreact",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.11.10",
    "@testing-library/user-event": "^12.8.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "ajv": "^8.0.0",
    "axios": "^1.12.2",
    "dotenv": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "^5.0.1",
    "typescript": "^5.9.3",
    "web-vitals": "^1.1.1"
  },
  "scripts": {
    "start": "concurrently \"npm run start:server:dev\" \"npm run start:client\"",
    "start:client": "react-scripts start",
    "start:server": "ts-node --project tsconfig.server.json server.ts",
    "start:server:dev": "nodemon --watch server.ts --exec ts-node --project tsconfig.server.json server.ts",
    "start:both": "concurrently \"npm run start:server:dev\" \"npm run start:client\"",
    "build": "react-scripts build",
    "build:server": "tsc --project tsconfig.server.json",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.14.0",
    "@babel/preset-react": "^7.13.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/axios": "^0.9.36",
    "@types/estree": "^1.0.8",
    "@types/express": "^5.0.3",
    "babel-jest": "^26.6.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jest": "^26.6.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2"
  },
  "jest": {
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    }
  }
}
